# SentinelAI Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sentinel_app:changeme@localhost:5432/sentinelai
GATEWAY_DATABASE_URL=postgresql+asyncpg://sentinel_gw:changeme@localhost:5432/sentinelai

# --- LLM ---
MISTRAL_API_KEY=
LLM_BACKEND=mock  # live|mock|replay

# --- Decision Provider ---
TYPESAFE_API_KEY=
DECISION_PROVIDER=mock  # jev|fallback_llm|rules|mock

# --- Auth ---
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
OPERATOR_SECRET=changeme-separate-operator-secret

# --- Kill Switch ---
KILL_SWITCH_DB_URL=postgresql+asyncpg://sentinel_operator:changeme@localhost:5432/sentinelai

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# --- Sandbox ---
SANDBOX_ENABLED=false
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT_MB=256
